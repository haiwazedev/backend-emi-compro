generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED

  @@map("article_status")
}

enum DivisionStatus {
  DRAFT
  PUBLISHED

  @@map("division_status")
}

enum DocumentCommitmentStatus {
  DRAFT
  PUBLISHED

  @@map("document_commitment_status")
}

enum FaqStatus {
  DRAFT
  PUBLISHED

  @@map("faq_status")
}

enum MediaType {
  PICTURE
  DOCUMENT

  @@map("media_type")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  @@map("users")
}

model ArticleCategory {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  slug     String    @unique @db.VarChar(100)
  articles Article[]

  @@map("article_categories")
}

model DocumentCommitmentCategory {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(100)
  documentCommitments DocumentCommitment[]

  @@map("document_commitment_categories")
}

model DocumentCommitment {
  id                           Int                        @id @default(autoincrement())
  documentCommitmentCategoryId Int                        @map("document_commitment_category_id")
  title                        String                     @db.VarChar(200)
  filePath                     String                     @map("file_path") @db.VarChar(255)
  filename                     String                     @unique @db.VarChar(255)
  size                         Int
  status                       DocumentCommitmentStatus   @default(DRAFT)
  uploadedAt                   DateTime                   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy                   String                     @map("uploaded_by") @db.VarChar(100)
  updatedAt                    DateTime?                  @map("updated_at") @db.Timestamptz(6)
  updatedBy                    String?                    @map("updated_by") @db.VarChar(100)
  documentCommitmentCategory   DocumentCommitmentCategory @relation(fields: [documentCommitmentCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([documentCommitmentCategoryId])
  @@map("document_commitments")
}

model Division {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(200)
  abbr      String         @db.VarChar(50)
  iconSvg   String?        @map("icon_svg") @db.Text
  status    DivisionStatus @default(DRAFT)
  sortOrder Int            @default(1) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String         @map("created_by") @db.VarChar(100)
  updatedAt DateTime?      @map("updated_at") @db.Timestamptz(6)
  updatedBy String?        @map("updated_by") @db.VarChar(100)
  services  Service[]

  @@map("divisions")
}

model Client {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(200)
  logoFilename  String    @map("logo_filename") @db.VarChar(500)
  logoFilepath  String    @map("logo_filepath") @db.VarChar(500)
  logoExtension String    @map("logo_extension") @db.VarChar(10)
  logoSize      Int       @map("logo_size")
  logoMetadata  Json      @map("logo_metadata") @db.JsonB
  sortOrder     Int       @default(1) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.VarChar(100)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.VarChar(100)

  @@index([sortOrder])
  @@map("clients")
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String    @db.VarChar(200)
  answer    String    @db.Text
  status    FaqStatus @default(DRAFT)
  sortOrder Int       @default(1) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.VarChar(100)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(100)

  @@index([status, sortOrder])
  @@map("faqs")
}

model Service {
  id         Int       @id @default(autoincrement())
  divisionId Int       @map("division_id")
  name       String    @db.VarChar(200)
  sortOrder  Int       @default(1) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.VarChar(100)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.VarChar(100)
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([divisionId, sortOrder])
  @@map("services")
}

model BoardMemberType {
  id      Int           @id @default(autoincrement())
  type    String        @db.VarChar(100)
  members BoardMember[]

  @@map("board_member_types")
}

model BoardMember {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(200)
  role              String          @db.VarChar(100)
  boardMemberTypeId Int             @map("board_member_type_id")
  photo             String?         @db.VarChar(255)
  sortOrder         Int             @default(1) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String          @map("created_by") @db.VarChar(100)
  updatedAt         DateTime?       @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?         @map("updated_by") @db.VarChar(100)
  boardMemberType   BoardMemberType @relation(fields: [boardMemberTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([boardMemberTypeId, sortOrder])
  @@map("board_members")
}

model Media {
  id        Int       @id @default(autoincrement())
  filename  String    @unique @db.VarChar(255)
  path      String    @db.VarChar(255)
  extension String    @db.VarChar(20)
  type      MediaType
  size      Int
  metadata  Json?     @db.JsonB
  createdBy String    @map("created_by") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  articles  Article[]
  contents  Content[]

  @@index([type])
  @@index([createdAt])
  @@map("media")
}

model Article {
  id                  Int              @id @default(autoincrement())
  articleCategoryId   Int              @map("article_category_id")
  issueDate           DateTime?        @map("issue_date") @db.Date
  pressReleaseNumber  String?          @map("press_release_number") @db.VarChar(255)
  primaryPhotoMediaId Int?             @map("primary_photo_media_id")
  cpName              String?          @map("cp_name") @db.VarChar(100)
  cpRole              String?          @map("cp_role") @db.VarChar(100)
  cpPhoneNumber       String?          @map("cp_phone_number") @db.VarChar(100)
  cpEmail             String?          @map("cp_email") @db.VarChar(100)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String           @map("created_by") @db.VarChar(100)
  updatedAt           DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?          @map("updated_by") @db.VarChar(100)
  articleCategory     ArticleCategory  @relation(fields: [articleCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  primaryPhotoMedia   Media?           @relation(fields: [primaryPhotoMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contents            ArticleContent[]

  @@index([articleCategoryId])
  @@index([primaryPhotoMediaId])
  @@map("articles")
}

model Language {
  id                  Int              @id @default(autoincrement())
  language            String           @db.VarChar(255)
  abbreviatedLanguage String           @unique @map("abbreviated_language") @db.VarChar(10)
  // Flag emoji; subdivision flags span up to 7 code points.
  flag                String           @db.VarChar(16)
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String           @map("created_by") @db.VarChar(100)
  updatedAt           DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?          @map("updated_by") @db.VarChar(100)
  articleContents     ArticleContent[]

  @@map("languages")
}

model ArticleContent {
  id         Int           @id @default(autoincrement())
  articleId  Int           @map("article_id")
  languageId Int           @map("language_id")
  title      String        @db.VarChar(120)
  slug       String        @db.VarChar(255)
  summary    String        @db.Text
  content    String        @db.Text
  status     ArticleStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String        @map("created_by") @db.VarChar(100)
  updatedAt  DateTime?     @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?       @map("updated_by") @db.VarChar(100)
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language   Language      @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([articleId, languageId])
  @@unique([languageId, slug])
  @@map("article_contents")
}

model Content {
  id        Int       @id @default(autoincrement())
  page      String    @db.VarChar(100)
  blockKey  String    @map("block_key") @db.VarChar(100)
  blockType String    @map("block_type") @db.VarChar(100)
  sortOrder Int       @default(1) @map("sort_order")
  data      Json?     @db.JsonB
  mediaId   Int?      @map("media_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.VarChar(100)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(100)
  media     Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([page, blockKey, blockType, sortOrder])
  @@map("contents")
}

model InboxSubject {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.VarChar(100)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(100)
  inboxes   Inbox[]

  @@map("inbox_subjects")
}

model Inbox {
  id             Int          @id @default(autoincrement())
  inboxSubjectId Int          @map("inbox_subject_id")
  name           String       @db.VarChar(100)
  email          String       @db.VarChar(254)
  company        String?      @db.VarChar(200)
  phone          String?      @db.VarChar(30)
  message        String       @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  inboxSubject   InboxSubject @relation(fields: [inboxSubjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inboxSubjectId])
  @@index([isRead])
  @@index([createdAt])
  @@map("inboxes")
}

model SiteSetting {
  id                     Int       @id @default(1)
  companyName            String    @map("company_name") @db.VarChar(200)
  companyShortName       String?   @map("company_short_name") @db.VarChar(50)
  danantaraLogoFilename  String?   @map("danantara_logo_filename") @db.VarChar(500)
  danantaraLogoFilepath  String?   @map("danantara_logo_filepath") @db.VarChar(500)
  danantaraLogoExtension String?   @map("danantara_logo_extension") @db.VarChar(10)
  danantaraLogoSize      Int?      @map("danantara_logo_size")
  danantaraLogoMetadata  Json?     @map("danantara_logo_metadata") @db.JsonB
  plnLogoFilename        String?   @map("pln_logo_filename") @db.VarChar(500)
  plnLogoFilepath        String?   @map("pln_logo_filepath") @db.VarChar(500)
  plnLogoExtension       String?   @map("pln_logo_extension") @db.VarChar(10)
  plnLogoSize            Int?      @map("pln_logo_size")
  plnLogoMetadata        Json?     @map("pln_logo_metadata") @db.JsonB
  companyAddress         String    @map("company_address") @db.VarChar(500)
  companyPhoneNumber     String?   @map("company_phone_number") @db.VarChar(30)
  companyWhatsappNumber  String?   @map("company_whatsapp_number") @db.VarChar(30)
  mainEmail              String?   @map("main_email") @db.VarChar(254)
  marketingEmail         String?   @map("marketing_email") @db.VarChar(254)
  operationalDay         String?   @map("operational_day") @db.VarChar(100)
  operationalStartTime   String?   @map("operational_start_time") @db.VarChar(5)
  operationalEndTime     String?   @map("operational_end_time") @db.VarChar(5)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String    @map("created_by") @db.VarChar(100)
  updatedAt              DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?   @map("updated_by") @db.VarChar(100)

  @@map("site_settings")
}

model SiteSocialMedia {
  id                       Int       @id @default(autoincrement())
  platformName             String    @map("platform_name") @db.VarChar(50)
  platformUrlOrAccountName String    @map("platform_url_or_account_name") @db.VarChar(255)
  iconFilename             String?   @map("icon_filename") @db.VarChar(500)
  iconFilepath             String?   @map("icon_filepath") @db.VarChar(500)
  iconExtension            String?   @map("icon_extension") @db.VarChar(10)
  iconSize                 Int?      @map("icon_size")
  iconMetadata             Json?     @map("icon_metadata") @db.JsonB
  status                   FaqStatus @default(DRAFT)
  sortOrder                Int       @default(1) @map("sort_order")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String    @map("created_by") @db.VarChar(100)
  updatedAt                DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?   @map("updated_by") @db.VarChar(100)

  @@index([status, sortOrder])
  @@map("site_social_medias")
}
