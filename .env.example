PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pln_emi_server?schema=public"
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-session-secret
FRONTEND_ORIGIN=http://localhost:3000

# SeaweedFS S3 gateway and pre-created bucket used for uploaded files.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=pln-emi-files
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-seaweedfs-access-key
S3_SECRET_KEY=replace-with-seaweedfs-secret-key


# SMTP sends invite and password reset emails. Port 465 uses TLS, 587 uses
# STARTTLS. Leave SMTP_USER unset for relays that allow the server by IP.
# Gmail/Workspace: smtp.gmail.com, SMTP_PASS is a Google App Password, and
# MAIL_FROM must be that account or a verified alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=replace-with-app-password
MAIL_FROM=PLN EMI <your-account@gmail.com>

# Optional direct OpenObserve logging. Leave these unset to log to stdout only.
# OPENOBSERVE_URL=https://api.openobserve.ai
# OPENOBSERVE_ORG=your-organization
# OPENOBSERVE_STREAM=pln_emi_server
# OPENOBSERVE_USERNAME=your-ingestion-username
# OPENOBSERVE_PASSWORD=your-ingestion-password
# LOG_LEVEL=info
