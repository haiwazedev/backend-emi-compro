generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED

  @@map("article_status")
}

enum DivisionStatus {
  DRAFT
  PUBLISHED

  @@map("division_status")
}

enum DocumentCommitmentStatus {
  DRAFT
  PUBLISHED

  @@map("document_commitment_status")
}

enum FaqStatus {
  DRAFT
  PUBLISHED

  @@map("faq_status")
}

enum MediaType {
  PICTURE
  DOCUMENT

  @@map("media_type")
}

enum UserTokenPurpose {
  INVITE
  RESET

  @@map("user_token_purpose")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  REORDER
  RESEND_INVITE

  @@map("activity_action")
}

enum ActivityResource {
  ARTICLE
  ARTICLE_CATEGORY
  BOARD_MEMBER
  BOARD_MEMBER_TYPE
  CLIENT
  DIVISION
  DOCUMENT_COMMITMENT
  DOCUMENT_COMMITMENT_CATEGORY
  FAQ
  MEDIA
  ROLE
  ROLE_PERMISSION
  SERVICE
  SITE_CONTENT
  SITE_SETTING
  USER

  @@map("activity_resource")
}

model User {
  id                Int         @id @default(autoincrement())
  name              String
  email             String      @unique
  // Null until the user accepts the invite.
  password          String?
  passwordChangedAt DateTime?   @map("password_changed_at") @db.Timestamptz(6)
  userRole          UserRole?
  tokens            UserToken[]

  @@map("users")
}

model UserToken {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  // SHA-256 of the emailed token; the raw token is never stored.
  tokenHash String           @unique @map("token_hash") @db.VarChar(64)
  purpose   UserTokenPurpose
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("user_tokens")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String           @map("created_by") @db.VarChar(100)
  updatedAt       DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?          @map("updated_by") @db.VarChar(100)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String           @map("created_by") @db.VarChar(100)
  updatedAt       DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?          @map("updated_by") @db.VarChar(100)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  isAllowed    Boolean    @default(false) @map("is_allowed")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String     @map("created_by") @db.VarChar(100)
  updatedAt    DateTime?  @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.VarChar(100)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique @map("user_id")
  // Null when the user has no role.
  roleId       Int?      @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastSignedIn DateTime? @map("last_signed_in") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.VarChar(100)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(100)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role         Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([roleId])
  @@map("user_roles")
}

model ArticleCategory {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  slug     String    @unique @db.VarChar(100)
  articles Article[]

  @@map("article_categories")
}

model DocumentCommitmentCategory {
  id                  Int                                 @id @default(autoincrement())
  documentCommitments DocumentCommitment[]
  contents            DocumentCommitmentCategoryContent[]

  @@map("document_commitment_categories")
}

model DocumentCommitment {
  id                           Int                         @id @default(autoincrement())
  documentCommitmentCategoryId Int                         @map("document_commitment_category_id")
  filePath                     String                      @map("file_path") @db.VarChar(255)
  filename                     String                      @unique @db.VarChar(255)
  size                         Int
  status                       DocumentCommitmentStatus    @default(DRAFT)
  uploadedAt                   DateTime                    @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy                   String                      @map("uploaded_by") @db.VarChar(100)
  updatedAt                    DateTime?                   @map("updated_at") @db.Timestamptz(6)
  updatedBy                    String?                     @map("updated_by") @db.VarChar(100)
  documentCommitmentCategory   DocumentCommitmentCategory  @relation(fields: [documentCommitmentCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contents                     DocumentCommitmentContent[]

  @@index([documentCommitmentCategoryId])
  @@map("document_commitments")
}

model DocumentCommitmentCategoryContent {
  documentCommitmentCategoryId Int                        @map("document_commitment_category_id")
  languageId                   String                     @map("language_id") @db.VarChar(10)
  name                         String                     @db.VarChar(100)
  slug                         String                     @db.VarChar(100)
  documentCommitmentCategory   DocumentCommitmentCategory @relation(fields: [documentCommitmentCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language                     Language                   @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([documentCommitmentCategoryId, languageId])
  @@unique([languageId, slug], map: "document_commitment_category_contents_language_id_slug_key")
  @@map("document_commitment_category_contents")
}

model DocumentCommitmentContent {
  documentCommitmentId Int                @map("document_commitment_id")
  languageId           String             @map("language_id") @db.VarChar(10)
  title                String             @db.VarChar(200)
  documentCommitment   DocumentCommitment @relation(fields: [documentCommitmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language             Language           @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([documentCommitmentId, languageId])
  @@map("document_commitment_contents")
}

model Division {
  id        Int               @id @default(autoincrement())
  iconSvg   String?           @map("icon_svg") @db.Text
  status    DivisionStatus    @default(DRAFT)
  sortOrder Int               @default(1) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String            @map("created_by") @db.VarChar(100)
  updatedAt DateTime?         @map("updated_at") @db.Timestamptz(6)
  updatedBy String?           @map("updated_by") @db.VarChar(100)
  services  Service[]
  contents  DivisionContent[]

  @@map("divisions")
}

model DivisionContent {
  divisionId  Int      @map("division_id")
  languageId  String   @map("language_id") @db.VarChar(10)
  name        String   @db.VarChar(200)
  slug        String   @db.VarChar(255)
  abbr        String   @db.VarChar(50)
  description String?  @db.Text
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([divisionId, languageId])
  @@unique([languageId, slug], map: "division_contents_language_id_slug_key")
  @@map("division_contents")
}

model Client {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(200)
  logoFilename  String    @map("logo_filename") @db.VarChar(500)
  logoFilepath  String    @map("logo_filepath") @db.VarChar(500)
  logoExtension String    @map("logo_extension") @db.VarChar(10)
  logoSize      Int       @map("logo_size")
  logoMetadata  Json      @map("logo_metadata") @db.JsonB
  sortOrder     Int       @default(1) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.VarChar(100)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.VarChar(100)

  @@index([sortOrder])
  @@map("clients")
}

model Faq {
  id        Int          @id @default(autoincrement())
  sortOrder Int          @default(1) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String       @map("created_by") @db.VarChar(100)
  updatedAt DateTime?    @map("updated_at") @db.Timestamptz(6)
  updatedBy String?      @map("updated_by") @db.VarChar(100)
  contents  FaqContent[]

  @@index([sortOrder])
  @@map("faqs")
}

model FaqContent {
  id         Int       @id @default(autoincrement())
  faqId      Int       @map("faq_id")
  languageId String    @map("language_id") @db.VarChar(10)
  question   String    @db.VarChar(200)
  answer     String    @db.Text
  status     FaqStatus @default(DRAFT)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.VarChar(100)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.VarChar(100)
  faq        Faq       @relation(fields: [faqId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language   Language  @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([faqId, languageId])
  @@index([languageId, status])
  @@map("faq_contents")
}

model Service {
  id         Int              @id @default(autoincrement())
  divisionId Int              @map("division_id")
  sortOrder  Int              @default(1) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String           @map("created_by") @db.VarChar(100)
  updatedAt  DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?          @map("updated_by") @db.VarChar(100)
  division   Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaLinks ServiceMedia[]
  contents   ServiceContent[]

  @@index([divisionId, sortOrder])
  @@map("services")
}

model ServiceContent {
  serviceId  Int      @map("service_id")
  languageId String   @map("language_id") @db.VarChar(10)
  name       String   @db.VarChar(200)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([serviceId, languageId])
  @@map("service_contents")
}

model ServiceMedia {
  serviceId Int                   @map("service_id")
  mediaId   Int                   @map("media_id")
  sortOrder Int                   @map("sort_order")
  service   Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media     Media                 @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contents  ServiceMediaContent[]

  @@id([serviceId, mediaId])
  @@unique([serviceId, sortOrder])
  @@index([mediaId])
  @@map("service_media")
}

model ServiceMediaContent {
  serviceId    Int          @map("service_id")
  mediaId      Int          @map("media_id")
  languageId   String       @map("language_id") @db.VarChar(10)
  description  String?      @db.Text
  serviceMedia ServiceMedia @relation(fields: [serviceId, mediaId], references: [serviceId, mediaId], onDelete: Cascade, onUpdate: Cascade)
  language     Language     @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([serviceId, mediaId, languageId])
  @@index([languageId])
  @@map("service_media_contents")
}

model BoardMemberType {
  id         Int                  @id @default(autoincrement())
  type       String               @db.VarChar(100)
  languageId String               @map("language_id") @db.VarChar(10)
  language   Language             @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contents   BoardMemberContent[]

  @@unique([id, languageId])
  @@index([languageId])
  @@map("board_member_types")
}

model BoardMember {
  id          Int                  @id @default(autoincrement())
  name        String               @db.VarChar(200)
  companyName String?              @map("company_name") @db.VarChar(100)
  photo       String?              @db.VarChar(255)
  sortOrder   Int                  @default(1) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String               @map("created_by") @db.VarChar(100)
  updatedAt   DateTime?            @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?              @map("updated_by") @db.VarChar(100)
  contents    BoardMemberContent[]

  @@index([sortOrder])
  @@map("board_members")
}

model BoardMemberContent {
  boardMemberId     Int             @map("board_member_id")
  languageId        String          @map("language_id") @db.VarChar(10)
  role              String          @db.VarChar(100)
  boardMemberTypeId Int             @map("board_member_type_id")
  description       String?         @db.Text
  boardMember       BoardMember     @relation(fields: [boardMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language          Language        @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  boardMemberType   BoardMemberType @relation(fields: [boardMemberTypeId, languageId], references: [id, languageId], onDelete: Cascade, onUpdate: Cascade)

  @@id([boardMemberId, languageId])
  @@index([boardMemberTypeId, languageId])
  @@map("board_member_contents")
}

model Media {
  id           Int            @id @default(autoincrement())
  filename     String         @db.VarChar(255)
  alt          String?        @db.VarChar(255)
  path         String         @db.VarChar(255)
  extension    String         @db.VarChar(20)
  type         MediaType
  size         Int
  metadata     Json?          @db.JsonB
  createdBy    String         @map("created_by") @db.VarChar(100)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  articles     Article[]
  serviceLinks ServiceMedia[]

  @@index([type])
  @@index([createdAt])
  @@map("media")
}

model Article {
  id                  Int              @id @default(autoincrement())
  articleCategoryId   Int              @map("article_category_id")
  issueDate           DateTime?        @map("issue_date") @db.Date
  pressReleaseNumber  String?          @map("press_release_number") @db.VarChar(255)
  primaryPhotoMediaId Int?             @map("primary_photo_media_id")
  cpName              String?          @map("cp_name") @db.VarChar(100)
  cpRole              String?          @map("cp_role") @db.VarChar(100)
  cpPhoneNumber       String?          @map("cp_phone_number") @db.VarChar(100)
  cpEmail             String?          @map("cp_email") @db.VarChar(100)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String           @map("created_by") @db.VarChar(100)
  updatedAt           DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?          @map("updated_by") @db.VarChar(100)
  articleCategory     ArticleCategory  @relation(fields: [articleCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  primaryPhotoMedia   Media?           @relation(fields: [primaryPhotoMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contents            ArticleContent[]

  @@index([articleCategoryId])
  @@index([primaryPhotoMediaId])
  @@map("articles")
}

model Language {
  // Lowercase language code, e.g. "id", "en".
  id                                 String                              @id @db.VarChar(10)
  language                           String                              @db.VarChar(255)
  // Flag emoji; subdivision flags span up to 7 code points.
  flag                               String                              @db.VarChar(16)
  sortOrder                          Int                                 @default(1) @map("sort_order")
  isActive                           Boolean                             @default(true) @map("is_active")
  createdAt                          DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                          String                              @map("created_by") @db.VarChar(100)
  updatedAt                          DateTime?                           @map("updated_at") @db.Timestamptz(6)
  updatedBy                          String?                             @map("updated_by") @db.VarChar(100)
  articleContents                    ArticleContent[]
  siteSettings                       SiteSetting[]
  siteContentItems                   SiteContentItem[]
  divisionContents                   DivisionContent[]
  serviceContents                    ServiceContent[]
  serviceMediaContents               ServiceMediaContent[]
  boardMemberTypes                   BoardMemberType[]
  boardMemberContents                BoardMemberContent[]
  faqContents                        FaqContent[]
  documentCommitmentContents         DocumentCommitmentContent[]
  documentCommitmentCategoryContents DocumentCommitmentCategoryContent[]

  @@map("languages")
}

model ArticleContent {
  id         Int           @id @default(autoincrement())
  articleId  Int           @map("article_id")
  languageId String        @map("language_id") @db.VarChar(10)
  title      String        @db.VarChar(120)
  slug       String        @unique @db.VarChar(255)
  summary    String        @db.Text
  content    String        @db.Text
  status     ArticleStatus @default(DRAFT)
  readTime   Int           @map("read_time")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String        @map("created_by") @db.VarChar(100)
  updatedAt  DateTime?     @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?       @map("updated_by") @db.VarChar(100)
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language   Language      @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([articleId, languageId])
  @@map("article_contents")
}

// Allowed blocks live in site-content-definitions.ts; rows are created on first save.
model SiteContent {
  id        Int               @id @default(autoincrement())
  page      String            @db.VarChar(100)
  blockKey  String            @map("block_key") @db.VarChar(100)
  blockType String            @map("block_type") @db.VarChar(100)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String            @map("created_by") @db.VarChar(100)
  items     SiteContentItem[]

  @@unique([page, blockKey, blockType])
  @@map("site_contents")
}

model SiteContentItem {
  id            Int         @id @default(autoincrement())
  siteContentId Int         @map("site_content_id")
  languageId    String      @map("language_id") @db.VarChar(10)
  sortOrder     Int         @default(1) @map("sort_order")
  // Block fields; media blocks hold `media_filepath` (a media.path, no FK).
  data          Json?       @db.JsonB
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String      @map("created_by") @db.VarChar(100)
  updatedAt     DateTime?   @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?     @map("updated_by") @db.VarChar(100)
  siteContent   SiteContent @relation(fields: [siteContentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language      Language    @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([siteContentId, languageId, sortOrder])
  @@index([languageId])
  @@map("site_content_items")
}

model InboxSubject {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.VarChar(100)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(100)
  inboxes   Inbox[]

  @@map("inbox_subjects")
}

model Inbox {
  id             Int          @id @default(autoincrement())
  inboxSubjectId Int          @map("inbox_subject_id")
  name           String       @db.VarChar(100)
  email          String       @db.VarChar(254)
  company        String?      @db.VarChar(200)
  phone          String?      @db.VarChar(30)
  message        String       @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  inboxSubject   InboxSubject @relation(fields: [inboxSubjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inboxSubjectId])
  @@index([isRead])
  @@index([createdAt])
  @@map("inboxes")
}

model SiteSetting {
  id         Int       @id @default(autoincrement())
  key        String    @db.VarChar(100)
  languageId String    @map("language_id") @db.VarChar(10)
  value      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.VarChar(100)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.VarChar(100)
  language   Language  @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([key, languageId])
  @@map("site_settings")
}

model SiteSocialMedia {
  id                       Int       @id @default(autoincrement())
  platformName             String    @map("platform_name") @db.VarChar(50)
  platformUrlOrAccountName String    @map("platform_url_or_account_name") @db.VarChar(255)
  iconFilename             String?   @map("icon_filename") @db.VarChar(500)
  iconFilepath             String?   @map("icon_filepath") @db.VarChar(500)
  iconExtension            String?   @map("icon_extension") @db.VarChar(10)
  iconSize                 Int?      @map("icon_size")
  iconMetadata             Json?     @map("icon_metadata") @db.JsonB
  status                   FaqStatus @default(DRAFT)
  sortOrder                Int       @default(1) @map("sort_order")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String    @map("created_by") @db.VarChar(100)
  updatedAt                DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?   @map("updated_by") @db.VarChar(100)

  @@index([status, sortOrder])
  @@map("site_social_medias")
}

model ActivityLog {
  id           Int              @id @default(autoincrement())
  // Plain name, not a users FK, so logs survive user deletes.
  userName     String           @map("user_name") @db.VarChar(100)
  action       ActivityAction
  resource     ActivityResource
  // Name of the affected item, kept as plain text; null when there is none.
  actionResult String?          @map("action_result") @db.VarChar(255)
  // Number of items affected by a bulk action.
  itemCount    Int?             @map("item_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String           @map("created_by") @db.VarChar(100)
  updatedAt    DateTime?        @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?          @map("updated_by") @db.VarChar(100)

  @@index([createdAt])
  @@map("activity_logs")
}

// Deployment-level settings, edited directly in the database.
model AppConfig {
  key   String @id
  value String

  @@map("app_configs")
}
